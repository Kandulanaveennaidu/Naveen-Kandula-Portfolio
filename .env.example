# PostgreSQL Database Persistence (Neon / Supabase / Render / Local)
# If empty, the app automatically uses safe local persistence for offline dev.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Transactional Email Notification (Resend / SMTP)
# Option A: Resend API (Recommended Free Tier)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Naveen Portfolio <inquiries@naveenkandula.dev>"

# Recipient Email for Client Inquiries
CONTACT_NOTIFICATION_EMAIL=kandulanaveennaidu017@gmail.com

# Option B: Standard SMTP (Alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kandulanaveennaidu017@gmail.com
SMTP_PASS=your_app_password_here
SMTP_SECURE=false

# Protected Admin Lead Dashboard Passcode
ADMIN_ACCESS_KEY=naveen_admin_secure_2026

# Canonical Domain URL
NEXT_PUBLIC_SITE_URL=https://naveenkandula.dev
